{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bangla-Hindi-English Bilingual Bridge Entry",
  "type": "object",
  "required": ["id", "bn", "hi", "pos", "hi_def", "match_tier"],
  "properties": {
    "id": { "type": "string", "pattern": "^bn-hi-[0-9]{6}$" },
    "bn": { "type": "string", "minLength": 1 },
    "hi": { "type": "string", "minLength": 1 },
    "pos": { "type": "array", "items": { "type": "string" } },
    "romanised": { "type": "array", "items": { "type": "string" } },
    "en": { "type": "array", "items": { "type": "string" } },
    "hi_def": { "type": "array", "items": { "type": "string" } },
    "bn_synonyms": { "type": "array", "items": { "type": "string" } },
    "hi_synonyms": { "type": "array", "items": { "type": "string" } },
    "hi_antonyms": { "type": "array", "items": { "type": "string" } },
    "examples": { "type": "array", "items": { "type": "string" } },
    "match_tier": { "type": "string", "enum": ["rich-both", "rich-wordnet"] }
  }
}
